<script>
    document.getElementById("startBtn").addEventListener("click", async () => {
        const response = await fetch("/api/timer/start");
        //const data = await response.json();
        //print(data);
        startTime = Date.now();
        updateTimerDisplay();
        timerInterval = setInterval(updateTimerDisplay, 1000);
    });

    document.getElementById("endBtn").addEventListener("click", async () => {
        clearInterval(timerInterval);
        document.getElementById("timerDisplay").textContent = "00:00";
        activityName = document.getElementById("name").value;
        const response = await fetch("/api/timer/stop", { // make a call to Timer service
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ activity_name: activityName }),
        });
        const data = await response.json();
        //print(data);
    });

    
    document.getElementById("createProject").addEventListener("click", async () => {
        project = document.getElementById("project").value;
        console.log("project text content: ", project);
        try {
            // call createProject
            console.log("fetching api endpoint"); //debug
            const response = await fetch("/api/createProject", { // make a call to Timer service
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ project: project }) // will be retrieved by const { project } = req.body;
            });
            //const data = await response.json();
            console.log("response recieved");
            console.log("response", response);
            if (response.ok) {
                console.log("Project created:", project); // project is data member of data
            }
        } catch (error) {
            console.error("Fetch error: ", error);
        }
    });
    

    function updateTimerDisplay() {
        console.log("timer start");
        let elapsedTime = Math.floor((Date.now() - startTime) / 1000);
        let minutes = Math.floor(elapsedTime / 60);
        let seconds = elapsedTime % 60;
        document.getElementById("timerDisplay").textContent =
            String(minutes).padStart(2, "0") + ":" + String(seconds).padStart(2, "0");
    }


</script>
