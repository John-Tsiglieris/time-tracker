<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Time Tracker</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<style>
    /* General Styling */
    body {
        font-family: Arial, sans-serif;
        background: black;
        color: white;
        margin: 0;
        padding: 0;
    }

    /* Week Display */
    #weekDisplay {
        text-align: center;
        font-size: 20px;
        font-weight: bold;
        margin: 20px 0;
    }

    /* Header Section (Week Navigation & Days) */
    .time-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #222;
        padding: 10px;
        border-bottom: 1px solid #444;
    }

    .time-header button {
        background: #444;
        color: white;
        border: none;
        padding: 5px 10px;
        cursor: pointer;
        border-radius: 4px;
    }

    .time-header button:hover {
        background: #666;
    }

    /* Days of the Week */
    .day {
        text-align: center;
        flex: 1;
        padding: 10px;
    }

    .day .date {
        font-size: 16px;
        font-weight: bold;
    }

    .duration {
        font-size: 14px;
        opacity: 0.8;
    }

    /* Main Section (Time Grid) */
    .main {
        display: flex;
    }

    /* Sidebar: Hours of the Day */
    .hours {
        display: grid;
        width: 60px;
        text-align: center;
        background: #333;
        border-right: 1px solid #444;
    }

    .hours div {
        padding: 10px 0;
        font-size: 12px;
    }

    .calendar {
        max-height: 82%; /* Adjust as needed */
        overflow: auto;
    }

    /* Calendar Grid (7 days, 24 hours) Half hour only just for display */
    .calendar-grid {
        display: grid;
        flex: 1;
        grid-template-columns: repeat(7, 1fr);
        grid-template-rows: repeat(46, 1fr);
        gap: 1px;
        background: #111;
    }

    .calendar-grid div {
        border: 1px solid #444;
        height: 40px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid gray;
    }

    /* Event Styling */
    .event {
        background: rgba(255, 255, 255, 0.2);
        color: white;
        text-align: center;
        border-radius: 4px;
        padding: 5px;
        font-size: 14px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    /* Hover Effect for Events */
    .event:hover {
        background: rgba(255, 255, 255, 0.4);
    }

</style>
