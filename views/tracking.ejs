    function updateWeekDisplay() {
        document.getElementById("weekDisplay").innerText = `Week #${getWeekNumber(currentDate)}`;

        // Update week dates (Start from Monday)
        let startOfWeek = new Date(currentDate);
        let dayOfWeek = startOfWeek.getDay(); // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
        let offset = dayOfWeek === 0 ? -6 : 1 - dayOfWeek; // Adjust so Monday is the first day

        startOfWeek.setDate(startOfWeek.getDate() + offset); // Move to Monday

        document.querySelectorAll('.day .date').forEach((el, index) => {
            let dayDate = new Date(startOfWeek);
            dayDate.setDate(startOfWeek.getDate() + index);
            el.innerText = `${dayDate.getDate()}`;
        });
    }


    document.getElementById("prevWeek").addEventListener("click", () => {
