    function updateActivityDisplay(activities) {
        const grid = document.querySelector(".calendar-grid");
        grid.innerHTML = ""; // Clear existing events

        console.log("about to create activities:");

        activities.forEach(activity => {
            console.log("activity.start: ", activity.start);
            const startDate = new Date(activity.start);
            const endDate = new Date(activity.end);
            console.log("startDate: ", startDate);

            const dayOfWeek = startDate.getDay(); // 0 = Sunday, 1 = Monday, ..., 6 = Saturday

            const startHour = startDate.getHours();
            console.log("startHour: ", startHour);
            const startMinute = startDate.getMinutes();
            console.log("startMinute: ", startMinute);

            const endHour = endDate.getHours();
            const endMinute = endDate.getMinutes();

            const startTotalMinutes = startHour * 60 + startMinute;
            console.log("startTotalMinutes: ", startTotalMinutes); // debug
            const endTotalMinutes = endHour * 60 + endMinute;

            const durationMinutes = endTotalMinutes - startTotalMinutes;

            // Align to half-hour increments
            const startHalfHours = Math.floor(startTotalMinutes / 30);
            console.log(startHalfHours);
            const durationHalfHours = Math.ceil(durationMinutes / 30); // Use ceil to ensure full coverage

            // Create event element
            const eventElement = document.createElement("div");
            eventElement.classList.add("event");
            eventElement.style.gridColumn = dayOfWeek + 1; // Align with the day's column
            eventElement.style.gridRow = `${startHalfHours + 1} / span ${Math.max(durationHalfHours, 1)}`;
            eventElement.innerText = activity.activityName;

            //debug
            console.log("row: ", `${startHalfHours + 1} / span ${Math.max(durationHalfHours, 1)}`);
            console.log(startHalfHours);
            grid.appendChild(eventElement);
            console.log("activity created!");
        });
        createGrid();
    }
    

    function createGrid() {
        const grid = document.querySelector(".calendar-grid");

        for (let i = 0; i < 7 * 24 * 2; i++) { // 7 days × 24 hours
            const cell = document.createElement("div");
            cell.classList.add("grid-cell");
            grid.appendChild(cell);
        }

    }

    createGrid();
    fetchActivities();
    updateWeekDisplay();
</script>
