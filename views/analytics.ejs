        console.log("weeknumber in analytics.ejs", weekNumber);
        this.submit();
    });
    

    function updateTimerDisplay() {
        console.log("timer start");
        let elapsedTime = Math.floor((Date.now() - startTime) / 1000);
        let minutes = Math.floor(elapsedTime / 60);
        let seconds = elapsedTime % 60;
        document.getElementById("timerDisplay").textContent =
            String(minutes).padStart(2, "0") + ":" + String(seconds).padStart(2, "0");
    }


</script>
<script>
    function getWeekNumber(date) {
        const startOfYear = new Date(date.getFullYear(), 0, 1); // Jan 1st
        const firstSunday = new Date(startOfYear);
        firstSunday.setDate(startOfYear.getDate() - startOfYear.getDay()); // Moves back to the first Sunday

        const diff = date - firstSunday;
        const oneWeek = 1000 * 60 * 60 * 24 * 7;
        
        return Math.floor(diff / oneWeek) + 1;
    }


    let currentDate = new Date();


    function updateWeekDisplay() {
        document.getElementById("weekDisplay").innerText = `Week #${getWeekNumber(currentDate)}`;

        // Update week dates (Start from Monday)
        let startOfWeek = new Date(currentDate);
        let dayOfWeek = startOfWeek.getDay(); // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
        let offset = dayOfWeek === 0 ? -6 : 1 - dayOfWeek; // Adjust so Monday is the first day

        startOfWeek.setDate(startOfWeek.getDate() + offset); // Move to Monday

        /*
        document.querySelectorAll('.day .date').forEach((el, index) => {
            let dayDate = new Date(startOfWeek);
            dayDate.setDate(startOfWeek.getDate() + index);
            el.innerText = `${dayDate.getDate()}`;
        });
        */
    }


    document.getElementById("prevWeek").addEventListener("click", () => {
        currentDate.setDate(currentDate.getDate() - 7);
        updateWeekDisplay();
        //fetchActivities();
    });

    document.getElementById("nextWeek").addEventListener("click", () => {
        currentDate.setDate(currentDate.getDate() + 7);
        updateWeekDisplay();
        //fetchActivities();
    });

    updateWeekDisplay();
</script>
